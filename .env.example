# promptly.app Environment Variables
# Copy this file to .env and fill in real values

# --- Database ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/promptly
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# --- JWT Authentication ---
SPRING_APP_JWT_SECRET=change_me_to_a_long_random_string_at_least_64_characters
SPRING_APP_JWT_EXPIRATION=3600000
SPRING_APP_JWT_REFRESH_EXPIRATION=604800000

# --- Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
SPRING_APP_SECRET_KEY=change_me_to_a_strong_random_key_32_chars_min

# --- AI Providers ---
SPRING_AI_DEFAULT_PROVIDER=openai-compatible
SPRING_AI_DEFAULT_BASE_URL=http://localhost:1234

# --- Frontend ---
APP_API_BASE_URL=http://localhost:8080
APP_URL=http://localhost:4200

# --- Production Deployment ---
# PAHOST=pahost.learnplay.co.za
# PAHOST_SSH_USER=paadmin
# PAHOST_SSH_PASSWORD=Liam@2018

# EditorConfig helps IDE maintain coding styles
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[{package.json,*.json}]
indent_size = 2

[{*.yml,*.yaml}]
indent_size = 2

[*.ts,*.js,*.css,*.scss]
indent_size = 2

[*.java]
indent_size = 4
tab_width = 4
